---
import Layout from '../layouts/Layout.astro';
import { intro, pages } from '../data/resume';
---

<Layout title="Isak Skoog" description={intro.line}>
  <section class="intro">
    <img src="/img/img.jpeg" alt={intro.name} class="avatar" />
    <h1>{intro.name}</h1>
    <p class="tagline">{intro.age}yo · {intro.role}</p>
    <p class="bio">{intro.line}</p>
    <p class="page-links">
      {pages.map((page) => <a href={page.href}>{page.label}</a>)}
    </p>
  </section>
</Layout>
