---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog — Isak Skoog" description="Posts by Isak Skoog">
  <h1>Blog</h1>
  <section>
    {posts.map((post) => (
      <div class="entry">
        <div class="entry-head">
          <b><a class="post-link" href={`/blog/${post.id}/`}>{post.data.title}</a></b>
          <span class="period">{post.data.date.toISOString().slice(0, 10)}</span>
        </div>
        {post.data.description && <div class="role">{post.data.description}</div>}
      </div>
    ))}
  </section>

</Layout>

<style>
  .post-link {
    color: #111;
    text-decoration: none;
  }

  .post-link:hover {
    text-decoration: underline;
    color: #0070f3;
  }

</style>
